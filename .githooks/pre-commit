#!/usr/bin/env bash
# pre-commit — block any commit that introduces a likely secret or PII. This is the
# structural backstop for the automated daily sync: even if the agent's judgment slips,
# a detected secret can't be committed. Mirrors the patterns in cli-tools/scrub-pii;
# kept self-contained so the kit depends on no external tool. Fail-closed by design.
set -euo pipefail

patterns=(
  'email:[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
  'jwt:eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+'
  'aws-akid:(AKIA|ASIA)[A-Z0-9]{16}'
  'github-token:gh[pousr]_[A-Za-z0-9]{20,}'
  'slack-token:xox[baprs]-[A-Za-z0-9-]{10,}'
  'private-key:-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'bearer:[Bb]earer [A-Za-z0-9._-]{20,}'
  'generic-secret:(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*[^[:space:]]{6,}'
  'private-ip:(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9]'
)

# Only the lines being ADDED, excluding this hook dir (whose pattern list would self-trip).
added="$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/' | grep -E '^\+[^+]' || true)"
[ -z "$added" ] && exit 0

hits=0
for p in "${patterns[@]}"; do
  name="${p%%:*}"; rx="${p#*:}"
  m="$(printf '%s\n' "$added" | grep -E -- "$rx" || true)"
  [ -n "$m" ] && { printf '  [%s] %s\n' "$name" "$(printf '%s' "$m" | head -1)"; hits=1; }
done

[ "$hits" -eq 0 ] && exit 0
echo "pre-commit: BLOCKED — the staged change looks like it contains a secret/PII (above)." >&2
echo "Remove it, or if it's a false positive: git commit --no-verify" >&2
exit 1
